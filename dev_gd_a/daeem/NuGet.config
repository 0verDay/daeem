<?xml version="1.0" encoding="utf-8"?>
<!--
  DAEEM 的 NuGet 源配置。

  ★ 为什么需要这个文件：本机**没有外网**到 nuget.org，而 Godot 的 C# 工程要用
    Godot.NET.Sdk / GodotSharp 这几个包。mono 版引擎把这些包**自带**在
    GodotSharp/Tools/nupkgs 里，所以这里把它加成一个本地源 —— 既能离线构建，
    也保证包版本与引擎**严格一致**（不会拉到别的 4.x 版本去）。

  ⚠️ 这个路径只在本机成立（与 tools/run-tests.ps1 里写死的引擎路径同类）。
     换机器时：改成本机 mono 版 Godot 的 GodotSharp/Tools/nupkgs，
     或者删掉这个文件、改用在线的 nuget.org。
-->
<configuration>
  <packageSources>
    <add key="godot-bundled" value="C:\D\GodotEngine\gd4.7.2mono\GodotSharp\Tools\nupkgs" />
  </packageSources>
  <config>
    <!--
      ★ 包缓存故意**放在 Godot 工程外面**（dev_gd_a/.nuget-packages，与 daeem/ 平级）：
        放进工程里的话 Godot 的文件扫描会把成千上万个包文件当成项目资源导入。
        相对路径按“本文件所在目录”解析，所以换机器也能用（只要目录结构一样）。
    -->
    <add key="globalPackagesFolder" value="..\.nuget-packages" />
  </config>
</configuration>
